{
  "name": "Nimbus",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Nimbus",
      "onAutoForward": "silent"
    }
  },
  "remoteEnv": {
    "HOST": "0.0.0.0"
  },
  "postCreateCommand": "npm install",
  "postStartCommand": "nohup bash .devcontainer/start.sh > /tmp/start.log 2>&1 &"
}

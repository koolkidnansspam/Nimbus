{
  "name": "Nimbus",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Nimbus",
      "onAutoForward": "silent"
    }
  },
  "remoteEnv": {
    "HOST": "0.0.0.0"
  },
  "postCreateCommand": "npm install",
  "postStartCommand": "nohup node server.js > /tmp/nimbus.log 2>&1 &"
}
